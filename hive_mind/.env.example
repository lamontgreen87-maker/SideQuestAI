# Primary Free AI API (Groq Free Tier)
# Get a free key at: https://console.groq.com/keys
BRAIN_PROVIDER=groq
BRAIN_API_KEY=gsk_your_free_groq_key_here
BRAIN_MODEL=openai/gpt-oss-120b

# Optional automatic fallback when Groq hits free-tier rate/daily limits
BRAIN_FALLBACK_PROVIDERS=groq,gemini,openrouter
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Full functionality & verification, paced slower for free API rate limits
FREE_TIER_MODE=1
BRAIN_MIN_CALL_INTERVAL_S=3.0

# Scheduled Science Bot (Full 4-drone stack: Scout -> Writer -> Critic -> Judge)
SCIENCE_MODE=full
SCIENCE_INTERVAL_MINUTES=30
SCIENCE_DRONE_DELAY_S=4.0
SCIENCE_ARXIV_GROUNDING=1
SCIENCE_TOPIC_FOCUS=
